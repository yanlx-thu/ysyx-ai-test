--- a/perip/sdram/sdram_top_apb.v
+++ b/perip/sdram/sdram_top_apb.v
@@ -24,6 +24,41 @@ module sdram_top_apb (
   inout  [15:0] sdram_dq
 );
 
+`ifdef FAST_SDRAM
+  import "DPI-C" function int soc_sdram_read(input int addr);
+  import "DPI-C" function void soc_sdram_write(input int addr, input int data, input int strb);
+
+  reg [31:0] read_data;
+  wire       req_fire = in_psel && !in_penable;
+
+  always @(posedge clock) begin
+    if (reset)
+      read_data <= 32'b0;
+    else if (req_fire) begin
+      if (in_pwrite) begin
+        soc_sdram_write(in_paddr, in_pwdata, {28'b0, in_pstrb});
+        read_data <= 32'b0;
+      end
+      else
+        read_data <= soc_sdram_read(in_paddr);
+    end
+  end
+
+  assign in_pready = in_psel && in_penable;
+  assign in_prdata = read_data;
+  assign in_pslverr = 1'b0;
+
+  assign sdram_clk = 1'b0;
+  assign sdram_cke = 1'b0;
+  assign sdram_cs = 1'b1;
+  assign sdram_ras = 1'b1;
+  assign sdram_cas = 1'b1;
+  assign sdram_we = 1'b1;
+  assign sdram_a = 13'b0;
+  assign sdram_ba = 2'b0;
+  assign sdram_dqm = 2'b0;
+  assign sdram_dq = 16'bz;
+`else
   wire sdram_dout_en;
   wire [15:0] sdram_dout;
   assign sdram_dq = sdram_dout_en ? sdram_dout : 16'bz;
@@ -77,4 +112,5 @@ module sdram_top_apb (
     .sdram_data_out_en_o(sdram_dout_en)
   );
 
+`endif
 endmodule
